# Telegram Bot API
BOT_TOKEN=PASTE_BOT_TOKEN_HERE

# Technical admins, comma-separated Telegram numeric IDs.
ADMIN_IDS=123456789
# Only OWNER_ID may create the Telethon login link / disconnect the user session.
OWNER_ID=123456789

# Local: bot.db
# Bothost: use /app/data/bot.db if /app/data is configured as persistent storage.
DB_PATH=/app/data/bot.db

# Bothost normally supplies PORT. If PORT exists, v7 automatically binds the web service to it.
# TELETHON_WEB_PORT=8080
TELETHON_WEB_HOST=0.0.0.0

# Set this to the HTTPS domain issued by Bothost if DOMAIN is not injected automatically.
# Example: https://my-xzona-bot.example.com
TELETHON_WEB_PUBLIC_URL=
TELETHON_WEB_TICKET_TTL=900

# Publish topic instructions once per v7 announcement version on startup.
ANNOUNCE_ON_START=1

# Temporary bot prompts/lists are deleted automatically after this many seconds.
TEMP_MESSAGE_TTL=90

# Telethon participant sync. 3600 = once per hour. 0 = disable automatic sync.
TELETHON_MEMBER_SYNC_INTERVAL=3600
