BOT_TOKEN=PASTE_BOT_TOKEN_HERE
# Telegram user IDs of technical admins, comma-separated.
ADMIN_IDS=123456789
# Only this Telegram user can create Telethon authorization links and disconnect the Telethon session.
OWNER_ID=123456789
DB_PATH=bot.db

# Browser window for Telethon authorization.
# Local PC launch:
TELETHON_WEB_HOST=127.0.0.1
TELETHON_WEB_PORT=8088
TELETHON_WEB_PUBLIC_URL=http://127.0.0.1:8088
# One-time login link lifetime, seconds.
TELETHON_WEB_TICKET_TTL=900

# If the bot is hosted on a server, bind to 0.0.0.0 and put the real HTTPS URL here, for example:
# TELETHON_WEB_HOST=0.0.0.0
# TELETHON_WEB_PUBLIC_URL=https://bot.example.com
